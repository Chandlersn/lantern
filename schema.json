    "vernier": {
      "id": "scale.vernier.deduction",
      "role": "游标",
      "yinyang": "阴（深层推理）",
      "measures": "抽象逻辑演绎深度 —— 这条知识「推理形态有多形式化」",
      "unit": "ld",
      "range": [
        0,
        100
      ],
      "resolution": 1,
      "kind": "continuous",
      "anchors": [
        {
          "at": 0,
          "label": "纯描述/叙事"
        },
        {
          "at": 25,
          "label": "归纳举证"
        },
        {
          "at": 50,
          "label": "条件推断"
        },
        {
          "at": 75,
          "label": "结构化论证"
        },
        {
          "at": 100,
          "label": "形式化证明"
        }
      ],
      "provider": {
        "id": "formal-structure-extractor/v1",
        "signal_family": "argumentative-syntax",
        "note": "只读推理连接词密度与论证句法结构，不读领域词。生产替换点：视觉/结构大模型看版式与论证骨架，或形式化抽取器。"
      },
      "known_limitation": "『逻辑是绝对刻度』是哲学立场而非事实。经典逻辑、直觉主义、各学科推理规范并不统一。本尺读数应理解为「本抽取器所操作化的那种逻辑」，仍是模型依赖的。"
    }
  },
  "independence_constraint": {
    "why": "卡尺的全部威力来自两尺读数之差。若两尺读数高度相关，偏移退化为噪声，闭环随即破产。",
    "rule": "理想情况下 main.provider.signal_family != vernier.provider.signal_family；但本系统当前两尺同源（llm 模式共用同一模型、启发式模式共用同一本地函数），signal_family 仅为 by-design 的语义标签，不保证物理独立。因此独立性只能靠「实证皮尔逊相关 r」持续监测，而非靠结构断言。",
    "runtime_guard": {
      "metric": "pearson_r(main_position, vernier_reading)",
      "healthy": "|r| < 0.6",
      "warn": "0.6 <= |r| < 0.85  → 偏移信息量下降，亮灯预警，仍允许写入",
      "fail": "|r| >= 0.85  → 判定两尺坍缩，偏移退化为噪声",
      "block_at": 0.6,
      "block_min_samples": 12,
      "block_policy": "当 |r| >= block_at 且样本数 n >= block_min_samples 时，系统拒绝自动写入/信任新的双尺读数（拉闸），已写入的条目照常保留、仅隔离其偏移；运营者通过 remeasure_all 显式更换 provider 后即为复位手段（该命令绕过拦截）。block_at 调到 0.85 则仅在『坍缩』时才拉闸。",
      "note": "block_min_samples 防止暖启动阶段样本过少时偶然相关误触发拉闸。"
    }
  },
  "offset": {
    "id": "reading.offset",
    "formula": "offset = vernier_reading - 基准(typical_vernier)；基准优先取学科域级 typical_vernier，无学科域时回退带级",
    "unit": "ld",
    "semantics": "学科域把基准收敛到该域常态推理形态；游标实测是 B，差值即卡尺读数。正偏移=推理形态比该学科域典型更形式化；负偏移=更叙事化。二者均为视角差异的客观读数，不表示内容优劣。",
    "interpretation": [
      {
        "sign": "positive",
        "meaning": "推理形态比该学科域典型更形式化 —— 跨域逻辑同构候选，或该内容借更严谨的骨架表达"
      },
      {
        "sign": "negative",
        "meaning": "推理形态比该学科域典型更叙事化 —— 可能是科普、综述，或另一种更发散的表达形态"
      }
    ]
  },
  "collision": {
    "id": "event.collision",
    "semantics": "neutral_attention_filter",
    "trigger": "abs(offset) > threshold（中立的注意力标记：「离域典型较远」，非缺陷判定）",
    "threshold": {
      "default": 18,
      "unit": "ld",
      "tunable_range": [
        5,
        40
      ],
      "note": "阈值仅为注意力过滤器：偏移超此值才进入候选关联/提醒流程，便于人工关注；不代表「错误」。当某学科域样本充足（≥4）时可升级为相对该域分布的 MAD，小库下退化回此处全局默认值。"
    },
    "resolution_paths": [
      {
        "path": "cross_link",
        "when": "证据不足以推翻原领域",
        "action": "生成形式相近关联候选（跨学科），喂给知识图谱"
      },
      {
        "path": "reclassify",
        "when": "多源证据支持归入目标领域",
        "action": "修订主尺读数（阴修订）"
      }
    ],
    "note": "偏移较大既可能是有意义的跨域洞见，也可能是分类偏差。闭环的职责是区分二者，而非默认其一——因此它被设计成中性注意力信号，绝不预先判定为「异常」。"
  },
  "graph_edge": {
    "id": "edge.candidate",
    "purpose": "把卡尺的连续偏移信号，翻译成知识图谱可消费的离散关系 —— 卡尺管发现，图谱管确定。",
    "fields": {
      "src_item": "源条目 id",
      "dst_band": "游标读数最匹配的目标领域",
      "kind": "logic-isomorphism | under-formalized",
      "offset": "生成时的偏移读数（作为置信证据）",
      "status": "candidate | accepted | rejected"
    },
    "review": "候选边默认不入正式图谱，需人工或高置信闭环确认后转 accepted。"
  },
  "closure": {
    "id": "loop.yinyang",
    "description": "阳→阴：主尺给出领域归类，游标回报「实测推理形态与该领域典型不符」的差异报告；阴→阳：推理据此修订主尺定位。互缠互生。",
    "anchor": "每轮修订必须回扣原始条目内容重算，禁止模型间互喂 —— 否则是发散螺旋，不是闭环。",
    "convergence": {
      "criterion": "abs(offset) <= threshold",
      "max_iterations": 12,
      "on_non_convergence": "标记 unresolved，转人工复核；不得无限迭代"
    },
    "cost_control": "重型 provider（视觉/大模型）仅在含视觉内容或首次入库时运行，其余走周期性重校准，不逐条实时调用。"
  }
}