{
  "schema": "lantern.caliper.dual-scale",
  "version": "1.0.0",
  "title": "灯笼 · 多维轴知识库 · 游标卡尺双尺规范",
  "description": "把「主尺 × 游标」从隐喻固化为可计算的度量规范。核心承诺：知识的定位不是离散标签，而是两把独立尺子在共享横梁上的连续读数；真正的信息量来自两读数之差（偏移），而非任一单尺。",
  "shared_beam": {
    "id": "beam.position",
    "description": "两尺共用的横梁（可比的公共标度）。任何尺子的读数都必须归一到该标度，否则偏移不可比。",
    "unit": "lantern-degree (ld)",
    "range": [
      0,
      100
    ],
    "precision": 0.1,
    "semantics": "自左向右单调递增。左端=具体/描述性/人文，右端=抽象/形式化/演绎。"
  },
